{
  "name": "fincrimeradar",
  "private": true,
  "type": "module",
  "description": "Build and validation tooling for the FinCrimeRadar static site. No runtime dependencies.",
  "engines": { "node": "24.x" },
  "scripts": {
    "manifest:refresh": "node scripts/build_manifest.mjs",
    "validate:content": "node scripts/validate_content.mjs",
    "sitemap:generate": "node scripts/generate_sitemap.mjs",
    "sitemap:check": "node scripts/generate_sitemap.mjs --check",
    "ads:strip-ineligible": "node scripts/strip_ineligible_ads.mjs",
    "verify:production": "node scripts/verify_production.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "validate:deploy": "node scripts/validate_deploy_surface.mjs",
    "ci": "npm run test && npm run sitemap:check && npm run validate:content && npm run validate:deploy"
  }
}
